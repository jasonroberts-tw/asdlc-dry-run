{
  "enabledPlugins": {
    "beads@beads-marketplace": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "node scripts/hooks/check-emitted-drift.mjs",
            "statusMessage": "Re-checking emitted-output drift",
            "timeout": 120,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "node scripts/hooks/guard-git.mjs",
            "statusMessage": "Checking the command against the worktree rules",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "node scripts/hooks/block-generated-edit.mjs",
            "statusMessage": "Checking the target is not generated output",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "node scripts/hooks/gate-summary.mjs",
            "statusMessage": "Running the fast gates",
            "timeout": 240,
            "type": "command"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "command": "node scripts/hooks/worktree-create.mjs",
            "statusMessage": "Provisioning the worktree off main with a briefing",
            "timeout": 120,
            "type": "command"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "command": "node scripts/hooks/worktree-remove.mjs",
            "statusMessage": "Removing the worktree",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ]
  }
}
