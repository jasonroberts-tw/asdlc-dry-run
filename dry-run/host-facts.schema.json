{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The dry-run run's environment facts",
  "description": "The shape of the one facts file a run's launcher writes under the run directory, once (dry-run/workflow-policy.json, block hostFacts, key file). tools/Write-HostFacts.ps1 writes it and tools/Test-HostFacts.ps1 validates it against this schema and refuses one that carries a secret value. Names and paths only: an environment variable is reported as present or absent, never by value.",
  "$comment": "kit 2.1-3 · ADAPT: this schema describes exactly what the writer emits as it was laid down, no key more and no key fewer, so the pair validates on the first day (dry-run/tests/host-facts.test.mjs proves it). The writer still measures facts that belong to the workflow it was taken from: a browser-test platform override, a directory-service ticket, a live gate, a test-id check. When you replace one of those blocks with a fact your runs measure, change the writer and this schema in the same commit; every object is closed (additionalProperties false), so a fact written without a schema entry is refused rather than ignored.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "writtenUtc", "writer", "story", "pluginRoot", "targetRoot", "runDirectory", "hostPrerequisites", "host", "playwright", "liveGate", "kerberos", "testIds", "environmentNames", "secretValuesReported"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "writtenUtc": { "type": "string", "minLength": 1 },
    "writer": { "type": "string", "minLength": 1 },
    "story": { "type": "integer", "minimum": 1, "description": "The work item's id." },
    "pluginRoot": { "type": "string", "minLength": 1, "description": "The workflow directory the tools ran from." },
    "targetRoot": { "type": "string", "minLength": 1, "description": "The checkout the run works in." },
    "runDirectory": { "type": "string", "minLength": 1, "description": "The directory this file sits in; the validator refuses a copy lying anywhere else." },
    "hostPrerequisites": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reportPath", "failed"],
      "properties": {
        "status": { "enum": ["ready", "incomplete", "skipped", "not-run"] },
        "reportPath": { "type": ["string", "null"] },
        "failed": { "type": "array", "items": { "type": "string" } }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "osRelease", "totalMemoryGb", "processorCount", "sequentialChainsBelowTotalMemoryGb", "sequentialChainsRequired"],
      "properties": {
        "platform": { "enum": ["windows", "macos", "linux"] },
        "osRelease": { "type": ["string", "null"] },
        "totalMemoryGb": { "type": "number", "minimum": 0 },
        "processorCount": { "type": "integer", "minimum": 1 },
        "sequentialChainsBelowTotalMemoryGb": { "type": "number", "minimum": 0 },
        "sequentialChainsRequired": { "type": "boolean" }
      }
    },
    "playwright": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostPlatformOverrideVariable", "hostPlatformOverride", "overrideRequired"],
      "properties": {
        "hostPlatformOverrideVariable": { "type": "string", "minLength": 1 },
        "hostPlatformOverride": { "type": ["string", "null"] },
        "overrideRequired": { "type": ["boolean", "null"] }
      }
    },
    "liveGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownedModeStartupTimeoutSeconds", "attachModeWhen", "attachModeProcedure", "seedPreflightNotDeclaredAcceptedWhen"],
      "properties": {
        "ownedModeStartupTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "attachModeWhen": { "type": "string" },
        "attachModeProcedure": { "type": "string" },
        "seedPreflightNotDeclaredAcceptedWhen": { "type": "string" }
      }
    },
    "kerberos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable", "ticketPresent", "ticketExpiresUtc", "ticketExpiresRaw", "realm", "note"],
      "properties": {
        "applicable": { "type": "boolean" },
        "ticketPresent": { "type": ["boolean", "null"] },
        "ticketExpiresUtc": { "type": ["string", "null"] },
        "ticketExpiresRaw": { "type": ["string", "null"] },
        "realm": { "type": ["string", "null"] },
        "note": { "type": "string" }
      }
    },
    "testIds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "scope", "planPath", "sharedTestProject", "invocation", "reason"],
      "properties": {
        "tool": { "type": "string" },
        "scope": { "type": "string" },
        "planPath": { "type": "string" },
        "sharedTestProject": { "type": ["string", "null"] },
        "invocation": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "environmentNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "tenant"],
      "properties": {
        "identity": { "type": "object", "additionalProperties": { "enum": ["present", "absent"] } },
        "tenant": { "type": "object", "additionalProperties": { "enum": ["present", "absent"] } }
      }
    },
    "secretValuesReported": { "const": false }
  }
}
